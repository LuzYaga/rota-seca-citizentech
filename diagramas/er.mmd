erDiagram
    BAIRRO ||--o{ RUA : "possui"
    BAIRRO ||--o{ ABRIGO_BAIRRO : "atendido por"
    ABRIGO ||--o{ ABRIGO_BAIRRO : "atende"
    RUA ||--o{ REPORTE_ALAGAMENTO : "localiza"
    USUARIO ||--o{ REPORTE_ALAGAMENTO : "registra"
    RUA ||--o{ AREA_CRITICA : "identificada como"
    BAIRRO ||--o{ AREA_CRITICA : "registrada em"

    BAIRRO {
        BIGINT id PK
        VARCHAR_100 nome
        VARCHAR_50 zona
        VARCHAR_20 nivel_risco
    }

    RUA {
        BIGINT id PK
        VARCHAR_150 nome
        VARCHAR_20 cep
        BIGINT id_bairro FK
    }

    USUARIO {
        BIGINT id PK
        VARCHAR_120 nome
        VARCHAR_100 contato
        VARCHAR_30 tipo
    }

    REPORTE_ALAGAMENTO {
        BIGINT id PK
        BIGINT id_rua FK
        BIGINT id_usuario FK
        VARCHAR_10 nivel
        TIMESTAMP data_hora
        VARCHAR_255 descricao
    }

    ABRIGO {
        BIGINT id PK
        VARCHAR_120 nome
        VARCHAR_200 endereco
        INT capacidade
    }

    ABRIGO_BAIRRO {
        BIGINT id_abrigo PK_FK
        BIGINT id_bairro PK_FK
        DECIMAL_5_2 distancia_km
    }

    AREA_CRITICA {
        BIGINT id PK
        BIGINT id_bairro FK
        BIGINT id_rua FK
        INT total_reportes
        TIMESTAMP data_marcacao
        VARCHAR_20 nivel_alerta
    }
