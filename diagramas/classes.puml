@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 6
skinparam shadowing false
skinparam dpi 220
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam class {
    BackgroundColor #F8FAFC
    ArrowColor #0284C7
    BorderColor #475569
    HeaderBackgroundColor #E2E8F0
}

package "br.com.rotaseca.model" #F1F5F9 {
    abstract class EntidadeBase {
        # Long id
        + getId(): Long
        + setId(Long id): void
    }

    enum NivelRisco {
        BAIXO
        MEDIO
        ALTO
        + fromString(String): NivelRisco
    }

    enum NivelAlagamento {
        LEVE
        MEDIO
        GRAVE
        - int peso
        + getPeso(): int
    }

    class Bairro {
        - String nome
        - String zona
        - NivelRisco nivelRisco
        + getNome(): String
        + setNome(String): void
        + getZona(): String
        + setZona(String): void
        + getNivelRisco(): NivelRisco
        + setNivelRisco(NivelRisco): void
    }

    class Rua {
        - String nome
        - String cep
        - Bairro bairro
        + getNome(): String
        + setNome(String): void
        + getCep(): String
        + setCep(String): void
        + getBairro(): Bairro
        + setBairro(Bairro): void
    }

    abstract class Usuario {
        # String nome
        # String contato
        # String tipo
        + getNome(): String
        + getContato(): String
        + getTipo(): String
        + {abstract} getDescricaoAlerta(): String
        + {abstract} getInfoAdicional(): String
    }

    class CidadaoMorador {
        - String observacaoResidencia
        + getDescricaoAlerta(): String
        + getInfoAdicional(): String
    }

    class CidadaoMobilidadeReduzida {
        - String necessidadeAcessibilidade
        + getDescricaoAlerta(): String
        + getInfoAdicional(): String
    }

    class Entregador {
        - String tipoVeiculo
        + getDescricaoAlerta(): String
        + getInfoAdicional(): String
    }

    class ReporteAlagamento {
        - Rua rua
        - Usuario usuario
        - NivelAlagamento nivel
        - LocalDateTime dataHora
        - String descricao
        + getPesoGravidade(): int
    }

    class Abrigo {
        - String nome
        - String endereco
        - int capacidade
        + getNome(): String
        + getCapacidade(): int
    }

    class AbrigoBairro {
        - Abrigo abrigo
        - Bairro bairro
        - double distanciaKm
        + getDistanciaKm(): double
    }

    class AreaCritica {
        - Bairro bairro
        - Rua rua
        - int totalReportes
        - LocalDateTime dataMarcacao
        - String nivelAlerta
    }
}

package "br.com.rotaseca.dao" #F8FAFC {
    interface Repositorio<T> {
        + inserir(T entidade): T
        + atualizar(T entidade): boolean
        + excluir(Long id): boolean
        + buscarPorId(Long id): T
        + listarTodos(): List<T>
    }

    class BairroDAO {
        + inserir(Bairro): Bairro
        + atualizar(Bairro): boolean
        + excluir(Long): boolean
        + buscarPorId(Long): Bairro
        + listarTodos(): List<Bairro>
        + atualizarNivelRisco(Long, NivelRisco): boolean
    }

    class ReporteDAO {
        + inserir(ReporteAlagamento): ReporteAlagamento
        + atualizar(ReporteAlagamento): boolean
        + excluir(Long): boolean
        + buscarPorId(Long): ReporteAlagamento
        + listarTodos(): List<ReporteAlagamento>
        + contarReportesPorRua(Long): int
    }
}

package "br.com.rotaseca.service" #F1F5F9 {
    class MonitoramentoService {
        - BairroDAO bairroDAO
        - RuaDAO ruaDAO
        - UsuarioDAO usuarioDAO
        - ReporteDAO reporteDAO
        - AbrigoBairroDAO abrigoBairroDAO
        - AreaCriticaDAO areaCriticaDAO
        + registrarReporte(Long, Long, String, String): ReporteAlagamento
        + recalcularEAtualizarRiscoBairro(Long): NivelRisco
        + avaliarGatilhoAreaCritica(Rua): void
        + listarAbrigosPorBairro(Long): List<AbrigoBairro>
    }
}

' Relacionamentos de Herança
EntidadeBase <|-- Bairro
EntidadeBase <|-- Rua
EntidadeBase <|-- Usuario
EntidadeBase <|-- ReporteAlagamento
EntidadeBase <|-- Abrigo
EntidadeBase <|-- AreaCritica

Usuario <|-- CidadaoMorador
Usuario <|-- CidadaoMobilidadeReduzida
Usuario <|-- Entregador

' Realizações de Interface
Repositorio <|.. BairroDAO
Repositorio <|.. ReporteDAO

' Associações de Domínio
Bairro "1" *-- "0..*" Rua : pertence a
Rua "1" *-- "0..*" ReporteAlagamento : localiza
Usuario "1" *-- "0..*" ReporteAlagamento : registra
Bairro "1" -- "0..*" AbrigoBairro
Abrigo "1" -- "0..*" AbrigoBairro

' Dependências das Camadas
MonitoramentoService ..> BairroDAO : usa
MonitoramentoService ..> ReporteDAO : usa
@enduml
